# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL do docker compose)
# ---------------------------------------------------------------------------
# Senha do PostgreSQL do container. Mude antes da primeira subida (depois disso,
# só apagando o volume: docker compose down -v).
POSTGRES_PASSWORD=crm
# Dentro do Docker, a API recebe a URL pelo docker-compose.yml. As duas abaixo servem
# para rodar a API ou os testes fora do Docker (pelo .venv), usando o banco do container.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Banco só dos testes de integração (criado pelo docker/postgres/init.sql): eles apagam
# e recriam as tabelas. Sem ela, os testes rodam só em SQLite e as variantes PostgreSQL
# são puladas.
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_test
# Alternativa sem Docker: a URL do Supabase (session pooler), com ?sslmode=require no final.

# Login do pgAdmin (http://localhost:5050). Só vale na primeira subida; para trocar depois:
# docker compose down, docker volume rm projeto_crm_pgadmin, docker compose up -d.
PGADMIN_EMAIL=admin@crm.com
PGADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Em produção: um valor aleatório com 32 caracteres ou mais (a API recusa o padrão).
JWT_SECRET=troque-este-valor-em-producao-por-um-segredo-longo
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Fuso do negócio: define a data de abertura/fechamento dos orçamentos
FUSO_HORARIO=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
